+// repoBrokerRoutes documents the read-only repo HTTP surface (broker_repo_http.go).
+// GET-only, bearer-auth, scoped to the intranet Gitea owner "twicedata", with a
+// server-side 64 KB cap on file reads. Registered in Broker.StartOnPort via
+// registerRepoRoutes so sandboxed apps on the bridge can list/read repo data
+// (TWICE-19294 / TWICE-145689) without any write surface.
+var repoBrokerRoutes = []brokerRoute{
+	{
+		contract: RouteContract{
+			Domain:       "repo",
+			Capability:   "Read-only repo listings and file contents",
+			Path:         "/repo/list",
+			Method:       http.MethodGet,
+			Auth:         RouteAuthBearer,
+			RequestType:  "query: repo?, path?",
+			ResponseType: "{repos: []team.brokerRepoSummary} | {repo, path, entries: []team.brokerRepoContentEntry}",
+		},
+		handler: func(b *Broker) http.HandlerFunc {
+			return b.handleRepoList
+		},
+	},
+	{
+		contract: RouteContract{
+			Domain:       "repo",
+			Capability:   "Read-only repo listings and file contents",
+			Path:         "/repo/read",
+			Method:       http.MethodGet,
+			Auth:         RouteAuthBearer,
+			RequestType:  "query: repo, path",
+			ResponseType: "text/plain file content (64 KB cap)",
+		},
+		handler: func(b *Broker) http.HandlerFunc {
+			return b.handleRepoRead
+		},
+	},
+}
