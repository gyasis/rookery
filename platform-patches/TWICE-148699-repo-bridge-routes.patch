+++ b/internal/team/broker_repo_http.go
@@ -0,0 +1,250 @@
+package team
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+)
+
+// Read-only repo access over the broker HTTP surface.
+//
+// The MCP tools (team_repo_list / team_repo_read in internal/teammcp) call
+// Gitea directly, so sandboxed apps on the app bridge — which can only issue
+// allowlisted broker GETs — have no way to reach repo data (TWICE-19294 /
+// TWICE-145689). These two handlers expose the SAME read-only surface as HTTP
+// routes, mirroring the MCP logic (env-configured Gitea host, owner scope
+// "twicedata", 64 KB read cap). They must stay GET-only and must never leak
+// the Gitea token or raw upstream URL into a response.
+
+// repoReadMaxBytes mirrors teammcp.repoReadMaxBytes: files served through the
+// broker are capped at 64 KB, truncated with a trailing note beyond that.
+const repoReadMaxBytes = 64 * 1024
+
+// giteaRequestTimeout bounds each upstream call, mirroring the MCP client's
+// 10-second timeout so a hung Gitea cannot wedge a broker handler.
+const giteaRequestTimeout = 10 * time.Second
+
+// giteaOwnerScope is the repo owner every route here is scoped to. Mirrors the
+// MCP tools, which hardcode twicedata as the owner for all repo operations.
+const giteaOwnerScope = "twicedata"
+
+// brokerGiteaConfig holds the Gitea base URL + token read from the environment.
+type brokerGiteaConfig struct {
+	baseURL string
+	token   string
+}
+
+// brokerGiteaConfigFromEnv reads GITEA_URL / GITEA_TOKEN exactly like the MCP
+// tools' giteaEnv(). Returns an error when not configured so handlers can
+// answer 503 without panicking.
+func brokerGiteaConfigFromEnv() (brokerGiteaConfig, error) {
+	token := strings.TrimSpace(os.Getenv("GITEA_TOKEN"))
+	base := strings.TrimRight(strings.TrimSpace(os.Getenv("GITEA_URL")), "/")
+	if token == "" || base == "" {
+		return brokerGiteaConfig{}, fmt.Errorf("Gitea repo host not configured: set GITEA_URL and GITEA_TOKEN environment variables")
+	}
+	return brokerGiteaConfig{baseURL: base, token: token}, nil
+}
+
+var brokerGiteaHTTPClient = &http.Client{Timeout: giteaRequestTimeout}
+
+// brokerGiteaGet performs a GET against the Gitea API with the server-side
+// token and returns the raw body (capped at repoReadMaxBytes+1, mirroring
+// teammcp.giteaGetRaw). Non-2xx statuses are NOT errors here — the caller
+// inspects the returned status and body to build its own response.
+func brokerGiteaGet(ctx context.Context, cfg brokerGiteaConfig, path string) ([]byte, int, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, cfg.baseURL+path, nil)
+	if err != nil {
+		return nil, 0, err
+	}
+	req.Header.Set("Authorization", "token "+cfg.token)
+	res, err := brokerGiteaHTTPClient.Do(req)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer res.Body.Close()
+	body, readErr := io.ReadAll(io.LimitReader(res.Body, repoReadMaxBytes+1))
+	if readErr != nil {
+		return nil, res.StatusCode, readErr
+	}
+	return body, res.StatusCode, nil
+}
+
+// encodeRepoPath URL-encodes each segment of a slash-separated path
+// individually (mirroring teammcp.encodePath), so path separators survive
+// while segment characters are escaped.
+func encodeRepoPath(p string) string {
+	segments := strings.Split(p, "/")
+	encoded := make([]string, 0, len(segments))
+	for _, seg := range segments {
+		if seg != "" {
+			encoded = append(encoded, url.PathEscape(seg))
+		}
+	}
+	return strings.Join(encoded, "/")
+}
+
+// --------------------------------------------------------------------------
+// Response shapes (mirror the MCP tool outputs so apps get the same fields)
+// --------------------------------------------------------------------------
+
+type brokerRepoSummary struct {
+	Name        string `json:"name"`
+	FullName    string `json:"full_name"`
+	Description string `json:"description"`
+	Private     bool   `json:"private"`
+	UpdatedAt   string `json:"updated_at"`
+}
+
+type brokerRepoContentEntry struct {
+	Name string `json:"name"`
+	Type string `json:"type"` // "file" or "dir"
+	Path string `json:"path"`
+}
+
+// --------------------------------------------------------------------------
+// Handlers
+// --------------------------------------------------------------------------
+
+// handleRepoList services GET /repo/list. With no repo param it returns all
+// hosted repos; with repo (+ optional path) it returns directory contents.
+// Mirrors teammcp.handleTeamRepoList.
+func (b *Broker) handleRepoList(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	cfg, err := brokerGiteaConfigFromEnv()
+	if err != nil {
+		writeJSON(w, http.StatusServiceUnavailable, map[string]string{"error": err.Error()})
+		return
+	}
+	repo := strings.TrimSpace(r.URL.Query().Get("repo"))
+	ctx := r.Context()
+	if repo == "" {
+		var result struct {
+			Data []brokerRepoSummary `json:"data"`
+		}
+		apiPath := "/api/v1/repos/search?limit=50&sort=updated&order=desc"
+		body, status, callErr := brokerGiteaGet(ctx, cfg, apiPath)
+		if callErr != nil {
+			writeJSON(w, http.StatusBadGateway, map[string]string{"error": fmt.Sprintf("list repos: %v", callErr)})
+			return
+		}
+		if status < 200 || status >= 300 {
+			writeJSON(w, http.StatusBadGateway, map[string]string{"error": fmt.Sprintf("list repos: HTTP %d", status)})
+			return
+		}
+		if err := json.Unmarshal(body, &result); err != nil {
+			writeJSON(w, http.StatusBadGateway, map[string]string{"error": fmt.Sprintf("list repos: %v", err)})
+			return
+		}
+		writeJSON(w, http.StatusOK, map[string]any{"repos": result.Data})
+		return
+	}
+	dirPath := strings.Trim(strings.TrimSpace(r.URL.Query().Get("path")), "/")
+	apiPath := "/api/v1/repos/" + giteaOwnerScope + "/" + url.PathEscape(repo) + "/contents"
+	if dirPath != "" {
+		apiPath += "/" + encodeRepoPath(dirPath)
+	}
+	body, status, callErr := brokerGiteaGet(ctx, cfg, apiPath)
+	if callErr != nil {
+		writeJSON(w, http.StatusBadGateway, map[string]string{"error": fmt.Sprintf("list %q/%q: %v", repo, dirPath, callErr)})
+		return
+	}
+	if status == http.StatusNotFound {
+		writeJSON(w, http.StatusNotFound, map[string]string{"error": fmt.Sprintf("repo or path not found: %q / %q", repo, dirPath)})
+		return
+	}
+	if status < 200 || status >= 300 {
+		writeJSON(w, http.StatusBadGateway, map[string]string{"error": fmt.Sprintf("list %q/%q: HTTP %d", repo, dirPath, status)})
+		return
+	}
+	var entries []brokerRepoContentEntry
+	if err := json.Unmarshal(body, &entries); err != nil {
+		writeJSON(w, http.StatusBadGateway, map[string]string{"error": fmt.Sprintf("list %q/%q: %v", repo, dirPath, err)})
+		return
+	}
+	for i := range entries {
+		if entries[i].Type != "dir" {
+			entries[i].Type = "file"
+		}
+	}
+	writeJSON(w, http.StatusOK, map[string]any{
+		"repo":    repo,
+		"path":    dirPath,
+		"entries": entries,
+	})
+}
+
+// handleRepoRead services GET /repo/read?repo=...&path=.... Returns raw file
+// content as text/plain, capped at 64 KB with a trailing truncation note —
+// mirroring teammcp.handleTeamRepoRead.
+func (b *Broker) handleRepoRead(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	cfg, err := brokerGiteaConfigFromEnv()
+	if err != nil {
+		writeJSON(w, http.StatusServiceUnavailable, map[string]string{"error": err.Error()})
+		return
+	}
+	repo := strings.TrimSpace(r.URL.Query().Get("repo"))
+	if repo == "" {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "repo is required"})
+		return
+	}
+	filePath := strings.Trim(strings.TrimSpace(r.URL.Query().Get("path")), "/")
+	if filePath == "" {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "path is required"})
+		return
+	}
+	apiPath := "/api/v1/repos/" + giteaOwnerScope + "/" + url.PathEscape(repo) + "/raw/" + encodeRepoPath(filePath)
+	body, status, callErr := brokerGiteaGet(r.Context(), cfg, apiPath)
+	if callErr != nil {
+		writeJSON(w, http.StatusBadGateway, map[string]string{
+			"repo":  repo,
+			"path":  filePath,
+			"error": fmt.Sprintf("read %q/%q: %v", repo, filePath, callErr),
+		})
+		return
+	}
+	if status == http.StatusNotFound {
+		writeJSON(w, http.StatusNotFound, map[string]string{
+			"repo":  repo,
+			"path":  filePath,
+			"error": "repo/path not found",
+		})
+		return
+	}
+	if status < 200 || status >= 300 {
+		writeJSON(w, http.StatusBadGateway, map[string]string{
+			"repo":  repo,
+			"path":  filePath,
+			"error": fmt.Sprintf("read %q/%q: HTTP %d", repo, filePath, status),
+		})
+		return
+	}
+	if len(body) > repoReadMaxBytes {
+		note := fmt.Sprintf("\n\n[truncated: file exceeds %d bytes; only the first %d bytes are shown]", repoReadMaxBytes, repoReadMaxBytes)
+		body = append(body[:repoReadMaxBytes:repoReadMaxBytes], []byte(note)...)
+	}
+	w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+	_, _ = w.Write(body)
+}
+
+// registerRepoRoutes registers the two read-only repo routes behind bearer
+// auth. Called from Broker.StartOnPort alongside registerPlatformRoutes /
+// registerTaskRoutes. GET-only: the handlers reject other methods and the
+// route contract pins Method to GET.
+func (b *Broker) registerRepoRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("/repo/list", b.requireAuth(b.handleRepoList))
+	mux.HandleFunc("/repo/read", b.requireAuth(b.handleRepoRead))
+}
