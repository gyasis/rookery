{
 "loop_limit": 10,
 "guard_allow": ["{tmp}", "~/.claude"],
 "busy_stale_s": 1800,
 "herdr_probe": true,
 "loop_pair_limit": 30,
 "_comment": "TMUX_PANE is UNTESTED: no tmux pane ran in the session that wrote this default (research D19).",
 "identity_binding_sources": {
  "HERDR_PANE_ID": "herdr-pane",
  "TMUX_PANE": "tmux-pane"
 },
 "session_binding_sources": {
  "HERDR_WORKSPACE_ID": "herdr-workspace"
 },
 "wake": {
  "herdr-pane": [
   [
    "herdr",
    "agent",
    "prompt",
    "{value}",
    "{text}"
   ]
  ],
  "tmux-pane": [
   [
    "tmux",
    "send-keys",
    "-t",
    "{value}",
    "-l",
    "{text}"
   ],
   [
    "tmux",
    "send-keys",
    "-t",
    "{value}",
    "Enter"
   ]
  ]
 },
 "default_binding": "herdr-pane",
 "launch": {
  "herdr-pane": {
   "env_flag": "--env",
   "steps": [
    {
     "argv": [
      "herdr",
      "tab",
      "create",
      "--cwd",
      "{cwd}",
      "--label",
      "{label}",
      "--no-focus",
      "{env}"
     ],
     "capture": "\"pane_id\"\\s*:\\s*\"([^\"]+)\""
    },
    {
     "argv": [
      "herdr",
      "pane",
      "run",
      "{pane}",
      "{cmd}"
     ],
     "join_cmd": true
    }
   ]
  },
  "tmux-pane": {
   "env_flag": "-e",
   "steps": [
    {
     "argv": [
      "tmux",
      "new-window",
      "-d",
      "-P",
      "-F",
      "#{pane_id}",
      "-n",
      "{label}",
      "-c",
      "{cwd}",
      "{env}",
      "{cmd}"
     ],
     "capture": "^(%\\d+)$"
    }
   ]
  }
 },
 "alive": {
  "herdr-pane": [
   "herdr",
   "pane",
   "get",
   "{value}"
  ],
  "tmux-pane": [
   "tmux",
   "display-message",
   "-p",
   "-t",
   "{value}",
   "#{pane_id}"
  ]
 },
 "harness": {
  "claude": {
   "cmd": [
    "claude"
   ],
   "settings_flag": "--settings",
   "prompt_file_flag": "--append-system-prompt-file",
   "add_dir_flag": "--add-dir"
  },
  "pi": {
   "cmd": [
    "pi"
   ],
   "prompt_flag": "--append-system-prompt"
  },
  "omp": {
   "cmd": [
    "omp"
   ],
   "prompt_flag": "--append-system-prompt"
  }
 },
 "ports": {
  "range": [
   47100,
   47999
  ],
  "names": [
   "api",
   "web"
  ]
 },
 "screener": {
  "checks": {
   "injection": "shadow",
   "duplicate": "shadow",
   "budget": "shadow",
   "thread": "shadow",
   "gates": "shadow",
   "t1": "shadow",
   "hunch": "shadow",
   "t2": "shadow"
  },
  "bands": {
   "t1": null
  },
  "base_url": "http://192.168.0.159:8799/llm/ollama",
  "model": "tev1:4b",
  "timeout_s": 300,
  "hunch": {
   "model": "qwen2.5:3b",
   "url": null
  },
  "t2": {
   "command": null,
   "batch": 20
  },
  "envelope_max_chars": 3000,
  "ask_budget": 20,
  "duplicate_window_s": 3600,
  "review_mode": {
   "default": "pre",
   "agents": {}
  },
  "lease_s": 600,
  "max_age_s": 86400
 }
}
