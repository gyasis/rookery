#!/usr/bin/env python3
"""Test double for herdr (T035). Appends json.dumps(sys.argv[1:]) as one line to the file named by env
HERDR_RECORD, then exits 0. It does nothing else and never talks to a real herdr."""
import json
import os
import sys

with open(os.environ["HERDR_RECORD"], "a") as fh:
    fh.write(json.dumps(sys.argv[1:]) + "\n")

# Optional: HERDR_STATUS=<idle|working|blocked|done> makes `agent list` report that status for pane w1:p2.
if sys.argv[1:3] == ["agent", "list"] and os.environ.get("HERDR_STATUS"):
    print(json.dumps({"id": "x", "result": {"agents": [
        {"pane_id": "w1:p2", "agent_status": os.environ["HERDR_STATUS"]}]}}))
