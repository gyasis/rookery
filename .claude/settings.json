{
  "_comment": "Hook scripts are symlinks into ~/.dev-kid/templates, which exists on the Linux dev box but not on every machine that clones this repo. Each command is guarded with [ -x ... ] so a missing or dangling symlink is a silent no-op instead of a 'No such file or directory' hook error on every session start, tool use and stop. -x follows symlinks, so a dangling link tests false.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/pre-compact.sh ] && .claude/hooks/pre-compact.sh || true"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/task-completed.sh ] && .claude/hooks/task-completed.sh || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/post-tool-use.sh ] && .claude/hooks/post-tool-use.sh || true"
          },
          {
            "type": "command",
            "command": "[ -x .claude/hooks/handoff-notifier.sh ] && .claude/hooks/handoff-notifier.sh || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/user-prompt-submit.sh ] && .claude/hooks/user-prompt-submit.sh || true"
          },
          {
            "type": "command",
            "command": "[ -x .claude/hooks/handoff-notifier.sh ] && .claude/hooks/handoff-notifier.sh || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/session-start.sh ] && .claude/hooks/session-start.sh || true"
          },
          {
            "type": "command",
            "command": "[ -x .claude/hooks/handoff-notifier.sh ] && .claude/hooks/handoff-notifier.sh || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/session-end.sh ] && .claude/hooks/session-end.sh || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/pre-tool-use.sh ] && .claude/hooks/pre-tool-use.sh || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/stop.sh ] && .claude/hooks/stop.sh || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/post-tool-use-failure.sh ] && .claude/hooks/post-tool-use-failure.sh || true"
          }
        ]
      }
    ]
  },
  "hookSettings": {
    "timeout": 30000,
    "env": {
      "DEV_KID_HOOKS_ENABLED": "true",
      "DEV_KID_AUTO_SYNC_GITHUB": "false",
      "DEV_KID_AUTO_CHECKPOINT": "true"
    }
  }
}
